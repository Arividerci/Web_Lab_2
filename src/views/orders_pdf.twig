<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <style>
        body { font-family: DejaVu Sans; font-size: 14px; }
        h1 { text-align: center; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th, td { border: 1px solid #000; padding: 8px; text-align: left; }
        th { background-color: #f0f0f0; }
    </style>
</head>
<body>

<h1>{{ title }}</h1>

<table>
    <thead>
        <tr>
            <th>Дата</th>
            <th>ФИО</th>
            <th>Email</th>
            <th>Телефон</th>
            <th>Бренд</th>
            <th>Модель</th>
            <th>Кол-во</th>
        </tr>
    </thead>
    <tbody>
        {% for order in orders %}
        <tr>
            <td>{{ order.created_at }}</td>
            <td>{{ order.name }}</td>
            <td>{{ order.email }}</td>
            <td>{{ order.phone }}</td>
            <td>{{ order.brand }}</td>
            <td>{{ order.model }}</td>
            <td>{{ order.quantity }}</td>
        </tr>
        {% endfor %}
    </tbody>
</table>

</body>
</html>
